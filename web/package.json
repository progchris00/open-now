{
  "name": "opennow-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "generate:api": "openapi-typescript ../backend/openapi.yaml -o src/api/schema.d.ts"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "^20.19.25",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "4.0.15",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.6",
    "jsdom": "27.2.0",
    "openapi-typescript": "7.13.0",
    "typescript": "^5.9.3",
    "vitest": "4.0.15"
  }
}
